#!/usr/bin/env bash
set -euo pipefail
AGS_BIN="${AGS_BIN:-${HOME}/.local/bin/ags}"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
THEME_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
CORE_TS="$THEME_DIR/core.ts"
[ -x "$AGS_BIN" ] || AGS_BIN="$(command -v ags)"
export AGS_BIN
. "$THEME_DIR/scripts/runtime.sh"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/cyberarch"
mkdir -p "$STATE"
prepare() (
    exec 7>"$CYBER_RUNTIME/build.lock"
    flock -w 45 7 || return 1
    staged="$(mktemp -d "$CYBER_RUNTIME/build.XXXXXX")"
    pointer="$(mktemp -u "$CYBER_RUNTIME/current.XXXXXX")"
    trap 'rm -f "$pointer"' EXIT
    if ! "$THEME_DIR/scripts/preflight" "$staged"; then rm -rf "$staged"; return 1; fi
    # Building a candidate never overwrites the last readiness-verified build.
    ln -s "$staged" "$pointer"
    mv -Tf "$pointer" "$CYBER_RUNTIME/current"
)

if [ "${1:-}" = --check ]; then
    stage="$(mktemp -d "$CYBER_RUNTIME/check.XXXXXX")"
    trap 'rm -rf "$stage"' EXIT
    "$THEME_DIR/scripts/preflight" "$stage"
    exit
fi
if [ "${1:-}" = --prepare ]; then prepare; exit; fi
exec 8>"$CYBER_RUNTIME/supervisor.lock"
flock -n 8 || exit 0
# A legacy unsupervised instance is adopted by scripts/restart after preflight.
if timeout 2 astal -i cyberpunk health >/dev/null 2>&1; then exit 0; fi
[ -L "$CYBER_RUNTIME/current" ] || prepare
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime_dir/$WAYLAND_DISPLAY" ] || {
    echo 'WAYLAND_DISPLAY must identify the current compositor' >&2; exit 1;
}
child=""
trap 'trap - TERM INT; [ -z "$child" ] || kill -- "-$child" 2>/dev/null; wait || true; exit 0' TERM INT
failures=0
while [ "$failures" -lt 5 ]; do
    build="$(readlink -f "$CYBER_RUNTIME/current")"
    started=$SECONDS
    # Bound log growth across starts, preserving the previous run.
    [ ! -f "$STATE/shell.log" ] || mv -f "$STATE/shell.log" "$STATE/shell.previous.log"
    setsid env CYBER_BUILD_ID="$build" CYBER_CSS="$build/shell.css" GDK_BACKEND=wayland \
        bash "$build/shell.js" 8>&- >>"$STATE/shell.log" 2>&1 &
    child=$!
    # Verify the named instance, not merely a live PID. The wrapper and GJS
    # share a process group so supervisor shutdown cannot orphan the HUD.
    for _ in $(seq 1 40); do
        kill -0 "$child" 2>/dev/null || break
        response="$(timeout 1 astal -i cyberpunk health 2>/dev/null || true)"
        if [ "$response" = "$build" ]; then
            pointer="$(mktemp -u "$CYBER_RUNTIME/healthy.XXXXXX")"
            ln -s "$build" "$pointer"
            mv -Tf "$pointer" "$CYBER_RUNTIME/healthy"
            break
        fi
        sleep 0.25
    done
    wait "$child" || true
    child=""
    if (( SECONDS - started > 60 )); then failures=0; fi
    failures=$((failures + 1))
    sleep "$failures"
done
echo 'Shell failed five times; inspect shell.log and run scripts/restart after repair.' >>"$STATE/shell.log"
exit 1
