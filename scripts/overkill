#!/usr/bin/env bash
DIR=$(cd "$(dirname "$0")" && pwd)
AUDIO="$DIR/../assets/audio"
. "$DIR/runtime.sh"
HUM_LOCK="$CYBER_RUNTIME/overkill_hum.lock"
. "$DIR/cfg.sh"
play_snd() {
    snd_on sndOverlay || return 0
    P=$(snd_path "$4" "$AUDIO/$1")
    setsid -f sh -c "play -q -v $2 \"$P\" 2>/dev/null || mpv --no-video --really-quiet --volume=$3 \"$P\" 2>/dev/null" >/dev/null 2>&1
}
start_hum() { # loop the kiroshi_menu ambience at 200%, keeps going until the lockfile is removed
    snd_on sndOverlay || return 0
    P=$(snd_path sndWheelActive "$AUDIO/kiroshi_menu.ogg")
    touch "$HUM_LOCK"
    setsid -f sh -c "while [ -e '$HUM_LOCK' ]; do play -q -v 2.0 \"$P\" 2>/dev/null || { mpv --no-video --really-quiet --volume=200 \"$P\" 2>/dev/null || break; }; done" >/dev/null 2>&1
}
stop_hum() {
    rm -f "$HUM_LOCK"
    pkill -f "$(snd_pat "$(snd_path sndWheelActive "$AUDIO/kiroshi_menu.ogg")")" 2>/dev/null
}

DAEMON_PID="$CYBER_RUNTIME/overkill.pid"
daemon_alive() {
    local pid
    read -r pid < "$DAEMON_PID" 2>/dev/null || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    [ -O "/proc/$pid" ] && tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fxq "$DIR/overkill-ui.py"
}
ensure_daemon() {
    daemon_alive && return 0
    exec 8>"$CYBER_RUNTIME/overkill-start.lock"
    flock -w 6 8 || return 1
    daemon_alive && { flock -u 8; return 0; }
    setsid -f python3 "$DIR/overkill-ui.py" 8>&- >/dev/null 2>&1
    i=0; while [ "$i" -lt 250 ]; do daemon_alive && { flock -u 8; return 0; }; sleep 0.02; i=$((i+1)); done
    flock -u 8
    return 1
}

case "${1:-enter}" in
  prewarm)
    ensure_daemon
    ;;
  enter)
    ensure_daemon || exit 1
    kill -USR2 "$(cat "$DAEMON_PID" 2>/dev/null)" 2>/dev/null   # instant: wake the resident overlay
    echo "KILL MODE ON"
    play_snd kiroshi_on.ogg 1.5 150 sndWheelStart   # the "powering on" blip
    start_hum                          # kick off the looping menu ambience (200% vol)
    hyprctl dispatch "hl.dsp.submap('kill')"
    ;;
  kill)
    MONS=$(hyprctl monitors -j) || exit 1
    CURSOR=$(hyprctl cursorpos -j) || exit 1
    PID=$(hyprctl clients -j | jq -r --argjson mons "$MONS" --argjson cursor "$CURSOR" '
      [.[] | . as $c |
        select(.pid > 1 and .mapped and (.hidden | not)) |
        select(any($mons[]; .id == $c.monitor and
          (if (.specialWorkspace.id // 0) != 0 then .specialWorkspace.id else .activeWorkspace.id end) == $c.workspace.id)) |
        select(.at[0] <= $cursor.x and $cursor.x < (.at[0]+.size[0]) and .at[1] <= $cursor.y and $cursor.y < (.at[1]+.size[1])) |
        select(.focusHistoryID >= 0)] | sort_by(.focusHistoryID) | .[0].pid // empty')
    [ -z "$PID" ] || [ "$PID" -le 1 ] && exit 1
    APP=$(ps -p "$PID" -o comm= 2>/dev/null | tr -d ' ')
    [ -z "$APP" ] && exit 1
    case "$APP" in
      Hyprland|hyprland|systemd|systemd-logind|login|Xorg|Xwayland|wayfire|river|emacs|ssh|sshd|sudo|su|dbus-daemon|dbus-broker|polkit*) exit 1 ;;
    esac
    kill -9 "$PID" 2>/dev/null
    play_snd kill.ogg 1.5 150 sndKillFile          # the "app killed" sound
    "$0" cleanup
    ;;
  exit|cleanup)
    echo "KILL MODE OFF"
    stop_hum                           # stop the looping menu ambience
    play_snd kiroshi_off.ogg 1.5 150 sndWheelEnd   # the power-down blip
    daemon_alive && kill -USR1 "$(cat "$DAEMON_PID" 2>/dev/null)" 2>/dev/null   # play outro + hide (stays resident)
    hyprctl dispatch "hl.dsp.submap('reset')"
    ;;
  stop)
    daemon_alive && kill -TERM "$(cat "$DAEMON_PID" 2>/dev/null)" 2>/dev/null
    rm -f "$DAEMON_PID"
    ;;
esac
