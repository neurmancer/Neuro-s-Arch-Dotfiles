#!/usr/bin/env bash
set -euo pipefail
STYLE="${1:-cybercore}"
[[ "$STYLE" =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
DIR="$(cd "$(dirname "$0")" && pwd)"
RIO="${XDG_CONFIG_HOME:-$HOME/.config}/rio"
SRC="${CYBER_DIR:-$(dirname "$DIR")}/assets/rio/styles/$STYLE.toml"
EXTRA="${2:-${XDG_CONFIG_HOME:-$HOME/.config}/cyberarch/rio_themes}"
[ -f "$SRC" ] || SRC="$EXTRA/$STYLE.toml"
[ -f "$SRC" ] || SRC="$RIO/styles/$STYLE.toml"
[ -f "$SRC" ] || { echo "Missing Rio style: $STYLE" >&2; exit 1; }
mkdir -p "$RIO"
python3 "$DIR/theme-config.py" rio "$SRC" "$RIO/config.toml"
